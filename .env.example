# Database
DATABASE_URL=postgresql://user:password@localhost:5432/cybermind

# NextAuth
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000

# App URL (used in emails, Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID=price_your_price_id

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=CyberMind <onboarding@resend.dev>

# Optional - Support/Sales email (defaults shown)
SUPPORT_EMAIL=support@cybermind.app
SALES_EMAIL=sales@cybermind.app
